[submodule "sql"]
	path = db-data
	url = https://github.com/HGNC/pgnc_db_schema.git
	branch = dev
[submodule "api"]
	path = api
	url = https://github.com/HGNC/pgnc-api.git
[submodule "server"]
	path = angular
	url = https://github.com/HGNC/pgnc-ext-angular.git
[submodule "solr"]
	path = solr
	url = https://github.com/HGNC/pgnc-solr.git

[submodule "nginx"]
	path = nginx
	url = https://github.com/HGNC/pgnc-ext-nginx.git
[submodule "solr-data"]
	path = solr-data
	url = https://github.com/HGNC/pgnc-ext-solr-data.git
[submodule "python"]
	path = python
	url = https://github.com/HGNC/pgnc_solr_load.git
[submodule "solr-client"]
	path = solr-client
	url = https://github.com/HGNC/pgnc-solr-client.git
