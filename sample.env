# DEV settings
# ------------
# LOCALHOST_* = ENV variable for the physical machine
# and not the container

# DB
DB_HOST=pgncdb
DB_PORT=5432
LOCALHOST_DB_PORT=5432
DB_NAME=pgnc
DB_USER=pgnc
DB_PASSWORD=<your-password>
DB_SYNC=false # set to true to sync the database in dev mode
DB_AUTOLOAD_ENTITIES=true

# Solr creds
SOLR_HOST=solr
SOLR_PORT=8983
LOCALHOST_SOLR_PORT=8983
SOLR_CORE=pgnc
SOLR_ADMIN_USER=admin
SOLR_ADMIN_PASSWORD=<solr_admin_password>
SOLR_CLIENT_USER=client
SOLR_CLIENT_PASSWORD=<solr_client_password>

# SOLR client
SOLR_CLIENT_PORT=3000
LOCALHOST_SOLR_CLIENT_PORT=3000

# API
LOCALHOST_API_PORT=3001
API_PORT=3001
PROFILE_API_KEY=api-key
JWT_SECRET=<secret>
JWT_TOKEN_AUDIENCE=<audience>
JWT_TOKEN_ISSUER=<issuer>
# Below is in seconds so 3600 is = 1 hour
JWT_ACCESS_TOKEN_TTL=3600
# # Below is 86400 = to 1 day
JWT_REFRESH_TOKEN_TTL=86400

# MAIL
MAIL_HOST=smtp.mailbox.etc
SMTP_USERNAME=<username>
SMTP_PASSWORD=<password>

# Angular
API_USER=webserver@email.com
API_PASSWORD=<password>
LOCALHOST_ANGULAR_PORT=4000
ANGULAR_PORT=4000

# NGINX
LOCALHOST_NGINX_PORT=80
NGINX_PORT=80
LOCALHOST_NGINX_SSL_PORT=443
NGINX_SSL_PORT=443

# Letsencrypt
MY_EMAIL=<email>

# API Keys (Required to enable respective provider)
# Use placeholders here; put real keys only in your local .env (never commit!)
# Formats (for reference only): Anthropic sk-ant-api03-..., OpenAI sk-proj-..., Perplexity pplx-..., OpenRouter sk-or-..., GitHub ghp_ or github_pat_
ANTHROPIC_API_KEY=<your_anthropic_key>
PERPLEXITY_API_KEY=<your_perplexity_key>
OPENAI_API_KEY=<your_openai_key>
GOOGLE_API_KEY=<your_google_key>
MISTRAL_API_KEY=<your_mistral_key>
XAI_API_KEY=<your_xai_key>
GROQ_API_KEY=<your_groq_key>
OPENROUTER_API_KEY=<your_openrouter_key>
AZURE_OPENAI_API_KEY=<your_azure_key>
OLLAMA_API_KEY=<your_ollama_key>
GITHUB_API_KEY=<your_github_pat>

# Certbot SSL Certificate Configuration
# ====================================
# These variables configure Certbot for automated SSL certificate provisioning
# using Google Cloud DNS for DNS-01 challenges.
#
# Setup Instructions:
# 1. Create a Google Cloud service account with DNS Admin permissions
# 2. Download the service account key JSON file
# 3. Place the key file in your project directory (e.g., ./gcp-key.json)
# 4. Update GCP_PROJECT and GCP_DNS_ZONE with your actual values
# 5. Mount the key file into the container at the path specified in GOOGLE_APPLICATION_CREDENTIALS
#
# For more details, see: SSL_RENEWAL_SETUP.md

# Google Cloud Service Account Key (Host Path)
# This is the path on your host machine to the service account key file
# Example: ./gcp-key.json or /absolute/path/to/service-account-key.json
GCP_KEY_FILE=./gcp-key.json

# Google Cloud Service Account Key (Container Path)
# This is the path inside the container where the key file will be mounted
# The certbot service will use this path to authenticate with Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-key.json

# Google Cloud Project ID (Required)
# The GCP project that contains your Cloud DNS zone
# Find this in Google Cloud Console under Project Info
# Example: my-project-123456
GCP_PROJECT=your-gcp-project-name

# Google Cloud DNS Zone Name (Required)
# The name of your Cloud DNS zone (not the domain name)
# Find this in Google Cloud Console -> Network Services -> Cloud DNS
# Example: my-domain-zone
GCP_DNS_ZONE=your-dns-zone-name

# DNS Record TTL (Optional)
# Time-to-live for DNS records in seconds
# Lower values mean faster propagation but higher DNS query load
# Default: 300 (5 minutes)
GCP_DNS_TTL=300

# DNS Propagation Wait Time (Optional)
# Time to wait for DNS changes to propagate before Certbot validation
# Increase if you experience validation failures due to slow DNS propagation
# Default: 60 seconds
GCP_DNS_PROPAGATION_WAIT=60
